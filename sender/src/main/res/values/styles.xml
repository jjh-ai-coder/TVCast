<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 点号命名的空基类：隐式父链要求祖先存在 -->
    <style name="TextAppearance.TVCast" parent="" />
    <style name="Widget.TVCast" parent="" />
    <style name="Shape.TVCast" parent="" />

    <!-- 字阶：Title 22 / Section 16 / Body 15 / Caption 13 -->
    <style name="TextAppearance.TVCast.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.TVCast.Section">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.TVCast.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.TVCast.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="Shape.TVCast.Button">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="Widget.TVCast.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="shapeAppearanceOverlay">@style/Shape.TVCast.Button</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.TVCast.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="shapeAppearanceOverlay">@style/Shape.TVCast.Button</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="iconTint">@color/textSecondary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.TVCast.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/Shape.TVCast.Button</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.TVCast.Button.Text.Destructive">
        <item name="android:textColor">@color/error</item>
        <item name="iconTint">@color/error</item>
        <item name="rippleColor">@color/rippleError</item>
    </style>

    <style name="Widget.TVCast.Button.Destructive" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="shapeAppearanceOverlay">@style/Shape.TVCast.Button</item>
        <item name="strokeColor">@color/error</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/error</item>
        <item name="iconTint">@color/error</item>
        <item name="rippleColor">@color/rippleError</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- 图标按钮：无文字，仅 icon（须配 contentDescription） -->
    <style name="Widget.TVCast.Button.Icon" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/textPrimary</item>
        <item name="strokeColor">@color/outline</item>
        <item name="shapeAppearanceOverlay">@style/Shape.TVCast.Button</item>
    </style>

    <style name="Widget.TVCast.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
    </style>
</resources>
