<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/safe_margin">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_tv" />

        <TextView
            android:id="@+id/device_name"
            style="@style/TextAppearance.TVCast.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/waiting_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/standby_waiting"
                android:textColor="@color/accent"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- IP 信息卡：手动直连与屏幕镜像都靠它，是待机页的视觉主角 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="28dp"
            android:paddingEnd="56dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/standby_address_label"
                android:textColor="@color/textDim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ip_address"
                style="@style/TextAppearance.TVCast.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/endpoint_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/textDim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/network_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/success"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/standby_hint"
            android:textColor="@color/textDim"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_settings"
        style="@style/Widget.TVCast.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:text="@string/standby_settings" />

    <TextView
        android:id="@+id/version_text"
        style="@style/TextAppearance.TVCast.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start" />
</FrameLayout>
